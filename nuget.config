<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The Strata local feed (../strata/local-feed) is deliberately NOT a global source:
         a configured-but-missing local source is a hard NU1301 restore error. It is added
         per-project via RestoreAdditionalProjectSources only when UseStrata=true — the same
         gate ps-bash uses (see src/PsAgent.Cmdlets/PsAgent.Cmdlets.csproj). -->
  </packageSources>
</configuration>
